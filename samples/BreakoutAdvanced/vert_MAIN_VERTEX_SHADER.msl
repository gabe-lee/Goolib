vertex main0_out main0(main0_in in [[stage_in]], constant type_WINDOW_RENDER_INFO& WINDOW_RENDER_INFO [[buffer(0)]], const device type_StructuredBuffer_SPRITE_VERTEX_DATA& SPRITE_VERTEX_DATA_BUFFER [[buffer(1)]])
