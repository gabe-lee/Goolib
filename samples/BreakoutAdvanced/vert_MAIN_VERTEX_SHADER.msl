#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct SPRITE_VERTEX_DATA
{
    float2 texture_uv;
    uint2 _pad_0;
};

struct type_StructuredBuffer_SPRITE_VERTEX_DATA
{
    SPRITE_VERTEX_DATA _m0[1];
};

struct type_GLOBAL
{
    float2 pos_offset;
    uint2 _pad_0;
};

struct main0_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    uint2 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex main0_out main0(main0_in in [[stage_in]], const device type_StructuredBuffer_SPRITE_VERTEX_DATA& SPRITE_VERTEX_DATA_BUFFER [[buffer(0)]])
{
    main0_out out = {};
    out.gl_Position = float4(in.in_var_TEXCOORD0, 1.0);
    out.out_var_TEXCOORD0 = SPRITE_VERTEX_DATA_BUFFER._m0[(in.in_var_TEXCOORD1.x * 4u) + in.in_var_TEXCOORD1.y].texture_uv;
    return out;
}

